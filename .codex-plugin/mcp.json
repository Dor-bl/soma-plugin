{
  "mcpServers": {
    "appium-mcp": {
      "command": "node",
      "args": ["./scripts/start-appium-mcp.mjs"],
      "cwd": ".",
      "env": {
        "NO_UI": "1"
      },
      "env_vars": ["ANDROID_HOME", "ANDROID_SDK_ROOT", "JAVA_HOME", "DEVELOPER_DIR", "APPIUM_MCP_WDA_APP_PATH", "SOMA_DATA_DIR", "SCREENSHOTS_DIR", "PAGE_SOURCES_DIR"],
      "startup_timeout_sec": 600
    }
  }
}
