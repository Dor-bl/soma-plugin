{
  "mcpServers": {
    "appium-mcp": {
      "command": "npx",
      "args": ["-y", "appium-mcp@1.97.1"],
      "env": {
        "REMOTE_SERVER_URL_ALLOW_REGEX": "^(https://[^/@?#]+|http://(localhost|127\\.0\\.0\\.1|\\[::1\\])(:[0-9]+)?)(/[^@?#]*)?$",
        "CAPABILITIES_CONFIG": "${user_config.capabilities_file}"
      }
    }
  }
}
